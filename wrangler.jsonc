// Cloudflare Workers static assets: publishes the Vite build in ./dist.
// Build command: npm run build   Deploy command: npx wrangler deploy
{
  "name": "fdm-basket",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Branch builds would get public preview URLs; keep them off unless needed.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // Unknown paths return a real 404 instead of the start page.
    "not_found_handling": "none"
  }
}
